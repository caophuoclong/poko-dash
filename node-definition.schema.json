{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-engine.local/schemas/node-definition.schema.json",
  "title": "WorkflowNodeDefinition",
  "description": "Complete specification for a workflow node definition in the visual workflow engine",
  "type": "object",
  "required": ["identity", "io", "execution", "config", "limits", "retry", "ui"],
  "properties": {
    "identity": { "$ref": "#/$defs/Identity" },
    "io": { "$ref": "#/$defs/IO" },
    "execution": { "$ref": "#/$defs/Execution" },
    "config": { "$ref": "#/$defs/Config" },
    "limits": { "$ref": "#/$defs/Limits" },
    "retry": { "$ref": "#/$defs/Retry" },
    "ui": { "$ref": "#/$defs/UI" }
  },
  "allOf": [
    {
      "$comment": "kind=execution nodes must have security section",
      "if": {
        "properties": {
          "identity": {
            "properties": { "kind": { "const": "execution" } }
          }
        }
      },
      "then": {
        "required": ["security"],
        "properties": {
          "security": { "$ref": "#/$defs/Security" }
        }
      }
    },
    {
      "$comment": "kind=agent nodes must have security section",
      "if": {
        "properties": {
          "identity": {
            "properties": { "kind": { "const": "agent" } }
          }
        }
      },
      "then": {
        "required": ["security"],
        "properties": {
          "security": { "$ref": "#/$defs/Security" }
        }
      }
    },
    {
      "$comment": "kind=resource nodes MUST NOT have security section",
      "if": {
        "properties": {
          "identity": {
            "properties": { "kind": { "const": "resource" } }
          }
        }
      },
      "then": {
        "not": {
          "required": ["security"]
        }
      }
    }
  ],
  "$defs": {
    "Identity": {
      "type": "object",
      "required": ["typeId", "version", "kind", "category", "title", "description"],
      "properties": {
        "typeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$",
          "description": "Immutable node type identifier (namespace.name)"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Schema version, increment on any breaking change"
        },
        "kind": {
          "type": "string",
          "enum": ["execution", "resource", "agent"],
          "description": "Node execution kind — drives routing and canvas rendering"
        },
        "category": {
          "type": "string",
          "enum": ["trigger", "logic", "data", "io", "resource", "agent", "crawl", "db", "content", "utility", "publish", "affiliate", "product"],
          "description": "UI grouping category for palette"
        },
        "title": {
          "type": "string",
          "maxLength": 48,
          "description": "Display name on canvas"
        },
        "description": {
          "type": "string",
          "maxLength": 140,
          "description": "Tooltip text in palette"
        },
        "icon": {
          "type": "string",
          "description": "Icon key from design system"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": "Search keywords for palette"
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "If true, hidden from palette but still executable"
        },
        "replacementTypeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$",
          "description": "Successor node typeId when deprecated=true"
        },
        "supportingOnly": {
          "type": "boolean",
          "default": false,
          "description": "If true, only available as agent tool, not in main palette"
        }
      },
      "if": {
        "properties": { "deprecated": { "const": true } }
      },
      "then": {
        "required": ["replacementTypeId"]
      }
    },
    "IO": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Port" },
          "description": "Input ports — empty for trigger and resource nodes"
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Port" },
          "description": "Output ports — empty for resource nodes, >=1 for execution nodes"
        }
      }
    },
    "Port": {
      "type": "object",
      "required": ["id", "label", "dataType", "edgeType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Port identifier used in edge routing"
        },
        "label": {
          "type": "string",
          "description": "Display label on canvas"
        },
        "dataType": {
          "$ref": "#/$defs/DataType"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "If true, connection is required for workflow validation"
        },
        "edgeType": {
          "type": "string",
          "enum": ["main", "error", "condition_true", "condition_false", "reference"],
          "description": "Edge rendering type — reference used for resource node connections"
        },
        "schema": {
          "type": "object",
          "description": "Optional JSON Schema for deep runtime data validation"
        }
      }
    },
    "DataType": {
      "type": "string",
      "enum": ["string", "number", "boolean", "object", "array", "array<object>", "any"],
      "description": "Typed data format for compile-time edge validation"
    },
    "Execution": {
      "oneOf": [
        { "$ref": "#/$defs/ExecutionBuiltin" },
        { "$ref": "#/$defs/ExecutionCustom" },
        { "$ref": "#/$defs/ExecutionResource" },
        { "$ref": "#/$defs/ExecutionAgent" }
      ]
    },
    "ExecutionBuiltin": {
      "$comment": "Builtin execution — engine interprets config generically",
      "type": "object",
      "required": ["mode", "builtinType", "idempotent"],
      "properties": {
        "mode": { "const": "builtin" },
        "builtinType": {
          "type": "string",
          "enum": ["filter", "map", "condition", "loop", "delay", "merge", "http", "webhook", "trigger", "aggregate"],
          "description": "Generic operator type executed by engine"
        },
        "idempotent": {
          "type": "boolean",
          "default": false,
          "description": "If true, safe to retry on failure with same input"
        }
      }
    },
    "ExecutionCustom": {
      "$comment": "Custom execution — delegates to TypeScript handler class",
      "type": "object",
      "required": ["mode", "handlerKey", "idempotent"],
      "properties": {
        "mode": { "const": "custom" },
        "handlerKey": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.]*$",
          "description": "Class name or DI token for handler lookup"
        },
        "idempotent": {
          "type": "boolean",
          "default": false,
          "description": "If true, safe to retry on failure with same input"
        }
      }
    },
    "ExecutionResource": {
      "$comment": "Resource node — config-only, resolved at compile time, never enqueued",
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "const": "resource" }
      }
    },
    "ExecutionAgent": {
      "$comment": "Agent node — runs think-act loop with private tool registry",
      "type": "object",
      "required": ["mode", "handlerKey", "modelProviderRef", "goal", "tools"],
      "properties": {
        "mode": { "const": "agent" },
        "handlerKey": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.]*$",
          "description": "Agent executor class (e.g. agent.AgentLoopHandler)"
        },
        "modelProviderRef": {
          "type": "string",
          "description": "UUID of resource.model_provider node in workflow graph"
        },
        "goal": {
          "type": "string",
          "description": "System prompt / objective for the agent LLM"
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "exitCondition": {
          "type": "string",
          "enum": ["done", "maxSteps", "error"],
          "default": "done"
        },
        "memoryStrategy": {
          "type": "string",
          "enum": ["none", "window", "summary"],
          "default": "window"
        },
        "windowSize": {
          "type": "integer",
          "minimum": 1,
          "default": 6,
          "description": "Number of message turns kept in LLM context"
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/AgentTool" },
          "minItems": 0
        },
        "idempotent": {
          "const": false,
          "description": "Agent nodes are never idempotent"
        }
      }
    },
    "AgentTool": {
      "type": "object",
      "required": ["nodeTypeId", "description"],
      "properties": {
        "nodeTypeId": {
          "type": "string",
          "description": "Node type the LLM may invoke"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "LLM-facing tool description (what the model sees)"
        },
        "exposed": {
          "type": "boolean",
          "default": true,
          "description": "If false, registered but disabled"
        }
      }
    },
    "Config": {
      "type": "object",
      "required": ["propertySchema", "defaultProps"],
      "properties": {
        "propertySchema": {
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyField" },
          "description": "Ordered list of inspector panel fields"
        },
        "defaultProps": {
          "type": "object",
          "description": "Default configuration values — keys must match propertySchema"
        }
      }
    },
    "PropertyField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "description": "Config key name"
        },
        "label": {
          "type": "string",
          "description": "UI label"
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "select", "multiselect", "url", "json", "code", "secret", "array", "text", "enum", "cron", "conditions", "assignments", "keyValue"],
          "description": "Input widget type"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Helper text"
        },
        "placeholder": {
          "type": "string"
        },
        "default": {
          "description": "Default value if not provided"
        },
        "options": {
          "type": "array",
          "description": "Options for select/multiselect types",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "value": {}
                }
              }
            ]
          }
        },
        "items": {
          "type": "object",
          "description": "JSON Schema for array item shape when type=array"
        },
        "validation": {
          "type": "object",
          "description": "JSON Schema fragment for save-time validation"
        },
        "showWhen": {
          "type": "object",
          "required": ["field", "equals"],
          "properties": {
            "field": { "type": "string" },
            "equals": {}
          },
          "description": "Conditional visibility based on another field value"
        },
        "displayWhen": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string" },
            "value": {}
          },
          "description": "Legacy conditional visibility (deprecated, use showWhen)"
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "language": { "type": "string", "description": "Language hint for code editor" }
      }
    },
    "Limits": {
      "type": "object",
      "required": ["timeoutMs", "maxInputItems", "maxOutputItems", "memoryMB"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000,
          "description": "Execution timeout — 0 for resource nodes"
        },
        "maxInputItems": {
          "type": "integer",
          "minimum": 0,
          "default": 10000
        },
        "maxOutputItems": {
          "type": "integer",
          "minimum": 0,
          "default": 10000
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 0,
          "default": 256
        }
      }
    },
    "Security": {
      "type": "object",
      "required": ["allowNetwork", "allowSecrets", "requiredPermissions"],
      "properties": {
        "allowNetwork": {
          "type": "boolean",
          "description": "If false, node runs in network-isolated worker"
        },
        "allowSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": "Secret key names this node may read"
        },
        "requiredPermissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Workspace permissions checked before job enqueue"
        }
      }
    },
    "Retry": {
      "type": "object",
      "required": ["safeToRetry", "maxRetries", "backoffMs"],
      "properties": {
        "safeToRetry": {
          "type": "boolean",
          "description": "If false, engine ignores maxRetries (node has side effects)"
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 0,
          "default": 1000,
          "description": "Initial backoff — engine uses exponential: backoffMs * 2^(attempt-1)"
        }
      }
    },
    "UI": {
      "type": "object",
      "required": ["color", "summaryFields"],
      "properties": {
        "color": {
          "type": "string",
          "enum": ["purple", "teal", "coral", "pink", "blue", "green", "amber", "red", "gray"],
          "description": "Node accent color on canvas"
        },
        "summaryFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "visible"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "visible": { "type": "boolean" }
            }
          },
          "description": "Fields shown on collapsed node card"
        },
        "helpUrl": {
          "type": "string",
          "format": "uri",
          "description": "Documentation link"
        }
      }
    }
  }
}
